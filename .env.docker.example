# Use 0.0.0.0 for direct public access. Use 127.0.0.1 behind Nginx/Caddy.
BIND_ADDR=0.0.0.0
PUBLIC_PORT=5177

# Host path to knowledge-base. Example on Linux: /opt/fuxi/ai-lib/knowledge-base
KB_ROOT_HOST=../ai-lib/knowledge-base

# Strongly recommended for public deployment. Format: username:password
BASIC_AUTH=admin:change-this-password
